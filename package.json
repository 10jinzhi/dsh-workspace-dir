{
  "name": "dsh-workspace-dir",
  "version": "1.3.0",
  "description": "Re-point a registered Harness workspace at another directory, or move a folder into a new parent, and let its sessions follow.",
  "type": "module",
  "exports": {
    ".": "./plugin.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "plugin.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-bundle",
    "workspace",
    "session"
  ],
  "author": "10jinzhi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10jinzhi/dsh-workspace-dir.git"
  },
  "homepage": "https://github.com/10jinzhi/dsh-workspace-dir#readme",
  "bugs": {
    "url": "https://github.com/10jinzhi/dsh-workspace-dir/issues"
  }
}
